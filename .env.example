# Database - Neon PostgreSQL
DATABASE_URL="postgres://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# NextAuth.js
AUTH_SECRET="your-secret-key-here"
AUTH_URL="http://localhost:3000"

# Admin Default Credentials
ADMIN_EMAIL="admin@elynd.com"
ADMIN_NAME="Elynd Admin"

# Social Media Widget
INSTAGRAM_WIDGET_ID="your-elfsight-instagram-widget-id"
TIKTOK_WIDGET_ID="your-elfsight-tiktok-widget-id"

# Google Maps
GOOGLE_MAPS_EMBED_URL="https://www.google.com/maps/embed?pb=your-maps-embed-url"

# WhatsApp Number
WHATSAPP_NUMBER="6281234567890"

# Clerk authentication and webhook verification
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
CLERK_WEBHOOK_SIGNING_SECRET="whsec_..."

# Vercel Cron authentication (generate a random server-side secret)
CRON_SECRET=""

# Cloudflare R2 banner storage (server-side only)
CLOUDFLARE_ACCOUNT_ID=""
R2_BUCKET_NAME=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_PUBLIC_URL="https://cdn.example.com"

# Transactional email provider (optional; required for PRD email notifications)
# Supported adapter values can be selected by the implementation: none, resend, smtp, custom
EMAIL_PROVIDER="none"
EMAIL_FROM="Elynd Beauty Salon <noreply@example.com>"
EMAIL_REPLY_TO=""
ADMIN_NOTIFICATION_USER_IDS=""
PROMOTION_NOTIFICATION_RECIPIENTS=""

# Resend-compatible provider
RESEND_API_KEY=""

# Generic SMTP provider
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
