#
# Module: Environment variable template
# Purpose: Document the non-secret configuration required by local and Vercel environments.
# Used by: Next.js app, Clerk auth, Neon/Drizzle, Cloudflare R2, cron routes, seed script, and Resend adapter.
# Dependencies: Provider accounts configured outside this repository.
# Public functions: None; configuration template only.
# Side effects: None; copy to .env.local and replace placeholders locally or in Vercel Environment Variables.
#

# Neon PostgreSQL
DATABASE_URL="postgres://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"
# Optional unpooled connection used by Drizzle migrations/DDL
DATABASE_URL_UNPOOLED="postgres://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# Clerk authentication and webhook verification
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
CLERK_WEBHOOK_SIGNING_SECRET="whsec_..."

# Seed defaults (development only)
ADMIN_EMAIL="admin@elynd.com"
ADMIN_NAME="Elynd Admin"

# Business/public content
WHATSAPP_NUMBER="6281234567890"
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL="https://www.google.com/maps/embed?pb=your-maps-embed-url"
INSTAGRAM_WIDGET_ID="your-elfsight-instagram-widget-id"
TIKTOK_WIDGET_ID="your-elfsight-tiktok-widget-id"

# Vercel Cron authentication (server-side only)
CRON_SECRET="generate-a-long-random-secret"

# Cloudflare R2 banner storage (server-side only)
CLOUDFLARE_ACCOUNT_ID=""
R2_BUCKET_NAME=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_PUBLIC_URL="https://cdn.example.com"

# Transactional email
# Set EMAIL_PROVIDER=resend when using the Resend adapter.
EMAIL_PROVIDER="resend"
EMAIL_FROM="Elynd Beauty Salon <noreply@example.com>"
EMAIL_REPLY_TO=""
RESEND_API_KEY="re_..."

# Comma-separated Clerk user IDs and email recipients
ADMIN_NOTIFICATION_USER_IDS="user_..."
PROMOTION_NOTIFICATION_RECIPIENTS="owner@example.com"
